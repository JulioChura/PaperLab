# Copia este archivo a .env y coloca tu key. El .env nunca se sube al repositorio.

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Umbral de confianza mínimo aceptado (0.0 a 1.0)
CONFIDENCE_THRESHOLD=0.8

# Tamaño máximo de imagen permitido en megabytes
MAX_IMAGE_SIZE_MB=10

# Timeout de llamada al LLM en segundos
LLM_TIMEOUT_SECONDS=60

# Número máximo de reintentos con feedback correctivo
MAX_RETRIES=1

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
