# Proveedor de IA: 'gemini' (directo, rápido ~2-4s) o 'openrouter'
LLM_PROVIDER=gemini

# Google Gemini API Key Directa (Recomendada)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (Opcional / multi-modelo alternativo)
OPENROUTER_API_KEY=sk-or-v1-tu-key-aqui
OPENROUTER_MODEL=google/gemini-2.5-flash

# Umbral de confianza mínimo aceptado (0.0 a 1.0)
CONFIDENCE_THRESHOLD=0.8

# Tamaño máximo de imagen permitido en megabytes
MAX_IMAGE_SIZE_MB=10

# Timeout de llamada al LLM en segundos
LLM_TIMEOUT_SECONDS=60

# Número máximo de reintentos con feedback correctivo
MAX_RETRIES=1

# Orígenes permitidos para CORS (separados por coma o comodín '*')
CORS_ORIGINS=*
