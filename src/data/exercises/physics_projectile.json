{
  "id": "physics_projectile",
  "name": "Tiro Parabólico",
  "topicId": "physics",
  "topicName": "Física Clásica",
  "description": "Lanzamiento balístico en dos dimensiones bajo aceleración constante de la gravedad, con cálculo de alcance máximo, altura máxima y tiempo de vuelo.",
  "visual_syntax": {
    "primary_shapes": ["ground_level_line", "launch_origin", "velocity_vector_arrow", "parabolic_trajectory_arc"],
    "secondary_markings": ["angle_arc_theta", "label_v0", "target_landing_point", "height_indicator_H"],
    "bounding_box_cues": {
      "origin": "coordinate (0,0) resting on ground line",
      "vector_arrow": "directional arrow labeled with initial speed v0 and angle theta",
      "ground": "extended horizontal line defining y = 0"
    }
  },
  "extracted_parameters": {
    "v0_mps": { "type": "number", "unit": "m/s", "default": 20.0, "description": "Velocidad inicial de disparo" },
    "theta_deg": { "type": "number", "unit": "deg", "default": 45.0, "description": "Ángulo de disparo con respecto a la horizontal" },
    "y0_m": { "type": "number", "unit": "m", "default": 0.0, "description": "Altura inicial de la boca de disparo" },
    "mass_kg": { "type": "number", "unit": "kg", "default": 0.25, "description": "Masa del proyectil" },
    "gravity": { "type": "number", "unit": "m/s^2", "default": 9.81, "description": "Aceleración gravitacional" }
  },
  "physics_model": {
    "formula_vx": "v0 * cos(theta)",
    "formula_vy": "v0 * sin(theta) - g * t",
    "formula_time_flight": "t_vuelo = (2 * v0 * sin(theta)) / g",
    "formula_max_height": "H_max = y0 + (v0^2 * sin(theta)^2) / (2 * g)",
    "formula_range": "X_max = (v0^2 * sin(2 * theta)) / g",
    "position_x": "x(t) = v0 * cos(theta) * t",
    "position_y": "y(t) = y0 + v0 * sin(theta) * t - 0.5 * g * t^2"
  },
  "simulation_render": {
    "overlay_type": "ballistic_arc",
    "vectors": [
      { "id": "v_vector", "name": "Velocidad Instantánea (v)", "color": "#06b6d4", "origin": "projectile_center", "direction": "tangent_to_curve" },
      { "id": "vx_vector", "name": "Componente Horizontal (vx)", "color": "#3b82f6", "origin": "projectile_center", "direction": "horizontal_right" },
      { "id": "vy_vector", "name": "Componente Vertical (vy)", "color": "#a855f7", "origin": "projectile_center", "direction": "vertical" },
      { "id": "g_vector", "name": "Gravedad (g)", "color": "#ef4444", "origin": "projectile_center", "direction": "downward" }
    ],
    "telemetry_hud": ["H_max", "X_max", "t_vuelo", "x_pos", "y_pos", "v_current"],
    "animation_mode": "continuous_time_stepped"
  }
}

